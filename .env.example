# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/open_cart_assignment

# Option 2: Use individual connection parameters
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=open_cart_assignment

# Database Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# SSL Configuration (set to 'true' for production with SSL)
# DATABASE_SSL=false

# OpenCart Integration (required in production; set after manual API user setup — see README)
# From host/browser tests use http://localhost:8081 — from app container use http://opencart
OPENCART_BASE_URL=http://opencart
OPENCART_API_USERNAME=unisouk-api
OPENCART_API_KEY=your-api-key-from-opencart-admin
OPENCART_TIMEOUT_MS=15000
OPENCART_MAX_RETRIES=3

# Redis / BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
BULLMQ_PREFIX=unisouk

# Inventory
LOW_STOCK_THRESHOLD=10

# Auth (required in production)
# JWT_SECRET=your-secret-key-min-32-chars
JWT_EXPIRES_IN=1d
# API_USER=admin
# API_PASSWORD_HASH=bcrypt-hash-of-api-password

# API Configuration
API_PREFIX=api
API_VERSION=v1

# CORS Configuration
# Multiple origins can be separated by commas
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=info
