# =============================================================================
# UniSouk OpenCart Backend — Environment Variables
# Copy to .env and adjust for your environment.
# See docs/SETUP.md for reviewer setup and docs/README architecture notes.
# =============================================================================

# --- Application ---
# HTTP port inside the container (keep 3000)
PORT=3000
# Host port exposed on the VPS when 3000/3001 are already in use (see docker-compose.prod.yml)
# APP_HOST_PORT=3002
# development | production | test
NODE_ENV=development

# --- PostgreSQL (Nest operational DB: sync_jobs, audit_logs) ---
# Option A: single connection URL (recommended for production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_cart_assignment

# Option B: individual parameters (used when DATABASE_URL is unset)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=open_cart_assignment

# Connection pool (Knex)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Set to 'true' when Postgres requires SSL (typical in managed cloud DBs)
# DATABASE_SSL=false

# --- OpenCart integration ---
# Base URL without trailing slash.
# Docker Compose (app/worker containers): http://opencart
# Host curl / browser tests: http://localhost:8081
OPENCART_BASE_URL=http://opencart
# Production only: public URL OpenCart uses for generated links (see docs/DEPLOY.md)
# OPENCART_PUBLIC_URL=http://203.0.113.10:8081/
# API user created in OpenCart admin (System → Users → API)
OPENCART_API_USERNAME=unisouk-api
# API key from OpenCart admin — never commit real keys
OPENCART_API_KEY=your-api-key-from-opencart-admin
# HTTP timeout and retry count for OpenCartClient
OPENCART_TIMEOUT_MS=15000
OPENCART_MAX_RETRIES=3

# --- Redis / BullMQ ---
# Docker Compose: redis | Local dev without Docker: localhost
REDIS_HOST=redis
REDIS_PORT=6379
# Queue name prefix (inventory-sync jobs)
BULLMQ_PREFIX=unisouk

# --- Inventory ---
# Default threshold for GET /api/v1/inventory/alerts when query param omitted
LOW_STOCK_THRESHOLD=10

# --- JWT auth (Nest API) ---
# Required in production (min 32 chars recommended). Dev default used when unset.
# JWT_SECRET=your-secret-key-min-32-chars
JWT_EXPIRES_IN=1d

# --- API login credentials (POST /api/v1/auth/login) ---
# Required in production. Dev defaults when unset in development:
#   username: admin
#   password: admin123
# API_USER=admin
# bcrypt hash of API password — generate with: node -e "require('bcrypt').hash('yourpass',10).then(console.log)"
# API_PASSWORD_HASH=$2b$10$s96y7L6Znwu7cCTB8B2iqu0T./Sg/atJ8z0mohZIbptFKyoySnGry

# --- HTTP API routing ---
# Global prefix segments: /{API_PREFIX}/{API_VERSION}/...
API_PREFIX=api
API_VERSION=v1

# --- CORS ---
# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# --- Logging (Winston) ---
LOG_DIR=logs
# error | warn | info | debug
LOG_LEVEL=info
